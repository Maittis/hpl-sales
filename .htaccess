Options -Indexes

# Never serve the credentials file directly (PHP includes it, the web must not).
# The schema and installer scripts are development tools. install.php accepts an
# unauthenticated POST that creates an admin account, and schema-check.php prints
# the live table layout, so neither may be reachable on the public site once the
# database exists. They are still available locally, and database.sql carries the
# schema if the database ever has to be rebuilt.
<FilesMatch "^(config\.php|config\.php\.example|.*\.sql|install\.php|schema-check\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
