Options -Indexes

# Never serve the credentials file directly (PHP includes it, the web must not).
# install.php is intentionally NOT blocked so it can be run once, then deleted.
<FilesMatch "^(config\.php|config\.php\.example|.*\.sql)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
